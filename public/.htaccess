# Apache / cPanel / LiteSpeed SPA Fallback Routing
# Ensures direct URLs route to index.html and any 404 redirects to homepage
ErrorDocument 404 /

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Allow ACME challenges and AI / Agentic discovery manifests in .well-known
  RewriteRule ^\.well-known/ - [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
